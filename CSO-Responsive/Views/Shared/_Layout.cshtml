@using CSO.Core.Security
@using Microsoft.AspNetCore.Http
@using CSO.Core.Repositories.SecurityActionRepo
@inject IHttpContextAccessor HttpContextAccessor
@inject ISecurityActionRepository _securityActionRepository

@{
    var userRoleId = HttpContextAccessor.HttpContext.Session.GetInt32("UserRole");

    // Detect device
    var ua = Context.Request.Headers["User-Agent"].ToString();
    var isMobile = ua.Contains("Mobi") || ua.Contains("Android") || ua.Contains("iPhone");

    // === Dashboard ===
    var canDashboardShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_DASHBOARD, (int)userRoleId);
    var canDashboardShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_DASHBOARD, (int)userRoleId);
    var canViewDashboard = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_DASHBOARD, (int)userRoleId);

    // === Users ===
    var canUsersShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_USERS, (int)userRoleId);
    var canUsersShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_USERS, (int)userRoleId);
    var canViewUsers = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_USERS, (int)userRoleId);

    // === CSOLOG ===
    var canCSOLogShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_CSOLOG, (int)userRoleId);
    var canCSOLogShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_CSOLOG, (int)userRoleId);
    var canViewCSOLog = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_CSOLOG, (int)userRoleId);

    // === ROOTCAUSE ===
    var canRootCauseShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_ROOTCAUSE, (int)userRoleId);
    var canRootCauseShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_ROOTCAUSE, (int)userRoleId);
    var canViewRootCause = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_ROOTCAUSE, (int)userRoleId);

    // === MONITOR ===
    var canMonitorShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_MONITOR, (int)userRoleId);
    var canMonitorShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_MONITOR, (int)userRoleId);
    var canViewMonitor = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_MONITOR, (int)userRoleId);

    // === APPROVE ===
    var canApproveShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_APPROVE, (int)userRoleId);
    var canApproveShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_APPROVE, (int)userRoleId);
    var canViewApprove = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_APPROVE, (int)userRoleId);

    // === CLOSURE ===
    var canClosureShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_CLOSURE, (int)userRoleId);
    var canClosureShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_CLOSURE, (int)userRoleId);
    var canViewClosure = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_CLOSURE, (int)userRoleId);

    // === MIS ===
    var canMISShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_MIS, (int)userRoleId);
    var canMISShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_MIS, (int)userRoleId);
    var canViewMIS = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_MIS, (int)userRoleId);

    // === CSOLOG_REPORT ===
    var canCSOLogReportShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_CSOLOG_REPORT, (int)userRoleId);
    var canCSOLogReportShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_CSOLOG_REPORT, (int)userRoleId);
    var canViewCSOLogReport = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_CSOLOG_REPORT, (int)userRoleId);

    // === MAILMATRIX ===
    var canMailMatrixShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_MAILMATRIX, (int)userRoleId);
    var canMailMatrixShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_MAILMATRIX, (int)userRoleId);
    var canViewMailMatrix = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_MAILMATRIX, (int)userRoleId);

    // === EMAIL_SMTP_SETTINGS ===
    var canEmailSmtpSettingsShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_EMAIL_SMTP_SETTINGS, (int)userRoleId);
    var canEmailSmtpSettingsShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_EMAIL_SMTP_SETTINGS, (int)userRoleId);
    var canViewEmailSmtpSettings = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_EMAIL_SMTP_SETTINGS, (int)userRoleId);

    // === DIVISION ===
    var canDivisionShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_DIVISION, (int)userRoleId);
    var canDivisionShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_DIVISION, (int)userRoleId);
    var canViewDivision = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_DIVISION, (int)userRoleId);

    // === CATEGORY ===
    var canCategoryShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_CATEGORY, (int)userRoleId);
    var canCategoryShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_CATEGORY, (int)userRoleId);
    var canViewCategory = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_CATEGORY, (int)userRoleId);

    // === COMPLAIN_TYPE ===
    var canComplainTypeShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_COMPLAIN_TYPE, (int)userRoleId);
    var canComplainTypeShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_COMPLAIN_TYPE, (int)userRoleId);
    var canViewComplainType = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_COMPLAIN_TYPE, (int)userRoleId);

    // === CSO_CLASS ===
    var canCSOClassShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_CSO_CLASS, (int)userRoleId);
    var canCSOClassShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_CSO_CLASS, (int)userRoleId);
    var canViewCSOClass = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_CSO_CLASS, (int)userRoleId);

    // === BRAND ===
    var canBrandShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_BRAND, (int)userRoleId);
    var canBrandShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_BRAND, (int)userRoleId);
    var canViewBrand = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_BRAND, (int)userRoleId);

    // === PRODUCT_TYPE ===
    var canProductTypeShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_PRODUCT_TYPE, (int)userRoleId);
    var canProductTypeShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_PRODUCT_TYPE, (int)userRoleId);
    var canViewProductType = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_PRODUCT_TYPE, (int)userRoleId);

    // === PLANT ===
    var canPlantShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_PLANT, (int)userRoleId);
    var canPlantShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_PLANT, (int)userRoleId);
    var canViewPlant = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_PLANT, (int)userRoleId);

    // === NEAREST_PLANT ===
    var canNearestPlantShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_NEAREST_PLANT, (int)userRoleId);
    var canNearestPlantShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_NEAREST_PLANT, (int)userRoleId);
    var canViewNearestPlant = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_NEAREST_PLANT, (int)userRoleId);

    // === RECYCLE_DAYS_CONFIGURATION ===
    var canRecycleDaysConfigurationShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_RECYCLE_DAYS_CONFIGURATION, (int)userRoleId);
    var canRecycleDaysConfigurationShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_RECYCLE_DAYS_CONFIGURATION, (int)userRoleId);
    var canViewRecycleDaysConfiguration = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_RECYCLE_DAYS_CONFIGURATION, (int)userRoleId);

    // === SECURITY_ACTIONS ===
    var canSecurityActionsShowOnMobile = isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_MOBILE_SECURITY_ACTIONS, (int)userRoleId);
    var canSecurityActionsShowOnDesktop = !isMobile && await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_DESKTOP_SECURITY_ACTIONS, (int)userRoleId);
    var canViewSecurityActions = await _securityActionRepository.CanDoAsync(SecurityActionsEnum.SEC_VIEW_SECURITY_ACTIONS, (int)userRoleId);

    var canShowCSOLogAnalysisAndSolutions = ((canRootCauseShowOnMobile || canRootCauseShowOnDesktop) || (canMonitorShowOnMobile || canMonitorShowOnDesktop)
                                             || (canApproveShowOnMobile || canApproveShowOnDesktop) || (canClosureShowOnMobile || canClosureShowOnDesktop))
                                             && (canViewRootCause || canViewMonitor || canViewApprove || canViewClosure);
    var canShowReports = ((canMISShowOnMobile || canMISShowOnDesktop) || (canCSOLogReportShowOnMobile || canCSOLogReportShowOnDesktop)) && (canViewMIS || canViewCSOLogReport);
    var canShowMasters = ((canDivisionShowOnMobile || canDivisionShowOnDesktop) || (canCategoryShowOnMobile || canCategoryShowOnDesktop) || (canComplainTypeShowOnMobile || canComplainTypeShowOnDesktop)
                          || (canCSOClassShowOnMobile || canCSOClassShowOnDesktop) || (canBrandShowOnMobile || canBrandShowOnDesktop) || (canProductTypeShowOnMobile || canProductTypeShowOnDesktop)
                          || (canPlantShowOnMobile || canPlantShowOnDesktop) || (canNearestPlantShowOnMobile || canNearestPlantShowOnDesktop) || (canRecycleDaysConfigurationShowOnMobile || canRecycleDaysConfigurationShowOnDesktop)
                          || (canSecurityActionsShowOnMobile || canSecurityActionsShowOnDesktop))
                          && (canViewDivision || canViewCategory || canViewComplainType || canViewCSOClass || canViewBrand || canViewProductType || canViewPlant || canViewNearestPlant
                          || canViewRecycleDaysConfiguration || canViewSecurityActions);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CSO - @ViewData["Title"]</title>
    @* <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" /> *@
    <link href="~/lib/bootstrap5/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/icomoon/styles.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/icons/fontawesome/styles.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/icons/material/styles.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap.css" rel="stylesheet" type="text/css" />
    <link href="~/css/bootstrap_limitless.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/layout.css" rel="stylesheet" type="text/css" />
    <link href="~/css/components.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/colors.min.css" rel="stylesheet" type="text/css" />
    <link href="~/css/switch.css" rel="stylesheet" />
    <link href="~/css/fontawesome/styles.min.css" rel="stylesheet" />
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <link href="~/js/sweetalert/sweetalert.css" rel="stylesheet" />
    <link href="~/css/buttons.dataTables.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" type="text/css" />
    <script src="~/js/jquery.min.js" type="text/javascript"></script>

    @RenderSection("styles", false)


    @*     <link rel="stylesheet" href="~/css/font-awesome.min.css"> *@

    <script>
        $(document).ready(function () {
            // Get the current URL
            var currentUrl = window.location.href.toLowerCase();

            // Highlight the active menu item for non-treeview items
            $('ul.nav-sidebar a').filter(function () {
                return this.href.toLowerCase() === currentUrl;
            }).addClass('menu-active');

            // For treeview items (submenus)
            $('ul.nav-group-sub a').filter(function () {
                return this.href.toLowerCase() === currentUrl;
            }).each(function () {
                // Open the parent submenu and highlight the active item
                $(this).closest('.nav-item-submenu').addClass('menu-open');
            });

            $('.nav-group-sub').each(function () {
                // Check if the submenu contains an active item
                if ($(this).find('.menu-active').length > 0) {
                    $(this).addClass('open');
                }
            });

            $('#ddlFinancialYear').on('change', function () {
                var selectedFY = $(this).val();

                // Send the selected year to the server and refresh the page
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SetFinancialYear", "Home")',
                    data: { fyear: selectedFY },
                    success: function (response) {
                        location.reload();
                    },
                    error: function () {
                        showDangerAlert("Something went wrong while setting Financial Year.");
                    }
                });
            });

            $("#iProfileIcon").click(function () {
                $("#myModal_Profile").modal('show');
            });
        });
    </script>

    <style>



        .navbar-nav-link {
            padding: 0 0 0 0 !important;
        }

        .fa-sign-out, .fa-user {
            font-size: 24px;
        }

        .modal-dialog-slideout {
            position: fixed;
            right: 2%;
            top: 13%;
            margin: 0;
            width: 300px;
            transform: translateX(100%);
            transition: transform 0.3s ease-out;
            z-index: 1050; /* Above backdrop */
        }

        .modal.fade.show .modal-dialog-slideout {
            transform: translateX(0);
        }

        .modal-content {
            border-radius: 0;
            border: none;
            box-shadow: 0 0 10px rgba(0,0,0,0.15);
            height: auto; /* <-- KEY: content-based height */
            max-height: 90vh; /* optional max height for very long content */
            overflow-y: auto; /* allows scroll if it grows too tall */
        }

        .Profilelabel {
            margin-left: 12px;
            font-weight: 500;
            font-size: 1rem;
        }

        .custom-label {
            font-weight: bold;
            font-size: 16px;
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: url('~/images/Rolling.gif') 50% 50% no-repeat rgb(249,249,249);
        }

        #cover-spin {
            position: fixed;
            width: 100%;
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            background-color: rgba(255,255,255,0.7);
            z-index: 9999;
            display: none;
        }

        -webkit-keyframes spin {
            from

        {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }

        }

        keyframes spin {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        #cover-spin::after {
            content: '';
            display: block;
            position: absolute;
            left: 48%;
            top: 40%;
            width: 40px;
            height: 40px;
            border-style: solid;
            border-color: black;
            border-top-color: transparent;
            border-width: 4px;
            border-radius: 50%;
            -webkit-animation: spin .8s linear infinite;
            animation: spin .8s linear infinite;
        }

        .menu-active {
            background-color: #fff !important;
            color: black !important;
            font-weight: bold;
            font-size: small;
            border-radius: 8px;
        }

        .nav-group-sub {
            display: none;
        }

            .nav-group-sub.open {
                display: block; /* Show the submenu when it has the 'open' class */
            }

        @@media (max-width: 768px) {
            #ddlFinancialYear {
                font-size: 16px;
                padding: 1px 5px;
            }
        }

        @@media (min-width: 769px) {
            #ddlFinancialYear {
                font-size: 14px;
                padding: 1px 5px;
            }
        }

    </style>

</head>

<body style="height:100%" class="sidebar-xs">

    <!-- Main navbar -->
    <!-- Main navbar -->
    <div class="navbar navbar-expand-md navbar-dark bg-indigo navbar-static px-3 py-2">

        <div class="d-flex align-items-center">
            <button class="navbar-toggler sidebar-mobile-main-toggle d-block p-0 me-2" type="button">
                <i class="icon-paragraph-justify3 text-white fs-5"></i>
            </button>
        </div>


        <!-- Title + Version -->
        <div class="text-white d-flex align-items-center fw-bold fs-6 me-3">
            <span class="d-none d-md-inline">Customer Satisfaction Opportunities</span>
            <span class="d-inline d-md-none">CSO</span>
            <span class="ms-2 small fw-normal">v1.0 | 01-05-2025</span>
        </div>

        <!-- FY Dropdown -->
        <div class="d-flex align-items-center ms-auto">
            <label class="mb-0 me-2 fw-bold text-white small">FY:</label>
            <select id="ddlFinancialYear" class="form-select form-select-sm" style="width:auto; min-width: 90px;">
                @{
                    var fyStartMonth = DateTime.Now.Month;
                    var fyYear = DateTime.Now.Year;
                    if (fyStartMonth > 3) { fyYear += 1; }
                    var selectedFyYear = HttpContextAccessor.HttpContext.Session.GetString("FYear");
                }
                @for (int i = 2021; i < fyYear; i++)
                {
                    var val = i.ToString().Substring(2) + (i + 1).ToString().Substring(2);
                    var text = i.ToString() + "-" + (i + 1).ToString().Substring(2);

                    if (val == selectedFyYear)
                    {
                        <option value="@val" selected>@text</option>
                    }
                    else
                    {
                        <option value="@val">@text</option>
                    }
                }
            </select>
        </div>



        <!-- Right side: Profile & Logout -->
        <div class="d-flex align-items-center ms-auto">
            <a class="text-white me-3" id="iProfileIcon" style="cursor:pointer">
                <i class="fa fa-user fs-5"></i>
            </a>
            <a href="@Url.Action("Login", "Account")" class="text-white"  style="cursor:pointer">
                <i class="icon-switch2"></i>
            </a>
        </div>

    </div>
    <!-- /Main navbar -->
    <!-- Page content -->
    <div class="page-content">

        <!-- Main sidebar -->
        <div class="sidebar sidebar-dark sidebar-main sidebar-expand-md">

            <!-- Sidebar mobile toggler -->
            <div class="sidebar-mobile-toggler text-center">
                <a href="#" class="sidebar-mobile-main-toggle">
                    <i class="icon-arrow-left8"></i>
                </a>
                <span class="font-weight-semibold">Menu</span>
                <a href="#" class="sidebar-mobile-expand ">
                    <i class="icon-screen-full"></i>
                    <i class="icon-screen-normal"></i>
                </a>
            </div>
            <!-- /sidebar mobile toggler -->
            <!-- Sidebar content -->
            <div class="sidebar-user-material">
                <div class="sidebar-user-material-body" style="background:white !important;padding:0px;">
                    <div class="card-body text-center" style="padding:10px !important;">
                        <a>
                            <img id="imglogo" name="imglogo" src="~/images/wipro-logo.png" class="img-fluid  shadow-0 " alt="" />
                        </a>
                        <h6 id="loginDtls" class="mb-0 text-white text-shadow-dark"> </h6>
                        <span id="spnRole" class="font-size-sm text-white text-shadow-dark"> </span>
                    </div>

                    <div class="sidebar-user-material-footer">
                    </div>
                </div>



                <!-- /user menu -->
                <!-- Main navigation -->
                <div class="card card-sidebar-mobile" id="divMnu">
                    <ul class="nav nav-sidebar" data-nav-type="accordion">
                    @if((canDashboardShowOnMobile || canDashboardShowOnDesktop) && canViewDashboard)
                    {
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link" id="Dashboard" title="Dashboard">
                                <i class="icon-home4"></i>
                                <span>
                                    Dashboard
                                </span>
                            </a>
                        </li>
                    }
                    @if((canUsersShowOnMobile || canUsersShowOnDesktop) && canViewUsers)
                    {
                        <li class="nav-item">
                                <a asp-controller="Users" asp-action="Index" class="nav-link" id="Users" title="User">
                                    <i class="icon-user"></i>
                                    <span>
                                        User
                                    </span>
                                </a>
                            </li>
                        }
                        @if ((canCSOLogShowOnMobile || canCSOLogShowOnDesktop) && canViewCSOLog)
                        {
                            <li class="nav-item">
                                <a asp-controller="CSOLog" asp-action="Index" class="nav-link" id="CSOLog" title="CSO Log">
                                    <i class="far fa-edit"></i>
                                    <span>
                                        CSO Log
                                    </span>
                                </a>

                        </li>
                    }
                    @if (canShowCSOLogAnalysisAndSolutions)
                    {
                        <li class="nav-item">
                            <a asp-controller="CSOLogAnalysisSolution" asp-action="CSOLogAnalysisSolution" class="nav-link" id="CSOLogAnalysisSolution" title="Analysis & Solution">
                                <i class="fas fa-clipboard-list"></i>
                                <span>
                                    Analysis & Solution
                                </span>
                            </a>
                        </li>
                    }
                    @if(canShowReports)
                    {
                        <li class="nav-item nav-item-submenu">
                            <a href="#" class="nav-link" title="Reports">
                                <i class="icon-file-eye"></i>
                                <span>
                                    Reports
                                </span>
                            </a>
                            <ul class="nav nav-group-sub" data-submenu-title="Reports">
                            @if((canMISShowOnMobile || canMISShowOnDesktop) && canViewMIS)
                            {
                                <li class="nav-item"><a asp-controller="MIS" asp-action="Index" class="nav-link" title="MIS">MIS</a></li>
                            }
                            @if((canCSOLogReportShowOnMobile || canCSOLogReportShowOnDesktop) && canViewCSOLogReport)
                            {
                                <li class="nav-item"><a asp-controller="CSOLogReport" asp-action="Index" class="nav-link" title="CSO Log Report">CSO Log Report</a></li>
                            }                                    
                            </ul>
                        </li>
                    }
                        @if ((canMailMatrixShowOnMobile || canMailMatrixShowOnDesktop) && canViewMailMatrix)
                        {
                            <li class="nav-item">
                                <a asp-controller="MailMatrix" asp-action="Index" class="nav-link" id="MailMatrix" title="Mail Matrix">
                                    <i class="fas fa-envelope-square"></i>
                                    <span>
                                        Mail Matrix
                                    </span>
                                </a>
                            </li>
                        }
                    @if((canEmailSmtpSettingsShowOnMobile || canEmailSmtpSettingsShowOnDesktop) && canViewEmailSmtpSettings)
                    {
                        <li class="nav-item">
                                <a asp-controller="SMTPSetting" asp-action="Index" class="nav-link" id="EmailConfiguration" title="Email/SMTP Setting">
                                <i class="fas fa-envelope-square"></i>
                                <span>
                                    Email/SMTP Setting
                                </span>
                            </a>
                        </li>
                    }
                    @if(canShowMasters)
                    {
                        <li class="nav-item nav-item-submenu">
                            <a href="#" class="nav-link" title="Master">
                                <i class="icon-file-eye"></i>
                                <span>
                                    Master
                                </span>
                            </a>
                                    <ul class="nav nav-group-sub">
                                    @if((canDivisionShowOnMobile || canDivisionShowOnDesktop) && canViewDivision)
                                    {
                                        <li class="nav-item"><a title="Division" asp-controller="Division" asp-action="Division" class="nav-link">Division</a></li>
                                    }
                                    @if((canCategoryShowOnMobile || canCategoryShowOnDesktop) && canViewCategory)
