@using CSO.Core.Security

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSO Dashboard</title>
    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"> *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .card-status {
            padding: 20px;
            border-radius: 10px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .card-status i {
                font-size: 2rem;
                opacity: 0.7;
            }

        .filters {
            overflow-x: auto;
            white-space: nowrap;
        }

            .filters > * {
                margin-right: 1rem;
            }
    </style>
</head>
<body>
    <div class="container-fluid p-4">
        <h3 class="text-primary mb-4">📊 CSO Dashboard</h3>

        <!-- Top Status Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnOpenStatus" data-status="@Status.Open.ToString()" class="card-status bg-primary"><div><h6>Open</h6><h4 id="openCount">0</h4></div><i class="fas fa-folder-open"></i></a>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnRootCauseStatus" data-status="@Status.RootCause.ToString()" class="card-status bg-danger"><div><h6>Root Caused</h6><h4 id="rootCausedCount">0</h4></div><i class="fas fa-bug"></i></a>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnMonitorStatus" data-status="@Status.Monitor.ToString()" class="card-status bg-warning text-dark"><div><h6>Monitored</h6><h4 id="monitoredCount">0</h4></div><i class="fas fa-eye"></i></a>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnApproveStatus" data-status="@Status.Approve.ToString()" class="card-status bg-info"><div><h6>Approved</h6><h4 id="approvedCount">0</h4></div><i class="fas fa-check-circle"></i></a>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnCloseStatus" data-status="@Status.Close.ToString()" class="card-status bg-success"><div><h6>Closed</h6><h4 id="closedCount">0</h4></div><i class="fas fa-lock"></i></a>
            </div>
            <div class="col-6 col-sm-4 col-md-2">
                <a href="javascript:void(0);" id="btnAllStatus" class="card-status" style="background-color: orange;"><div><h6>All</h6><h4 id="allCount">0</h4></div><i class="fas fa-layer-group"></i></a>
            </div>
        </div>

        <!-- Filters and Export Buttons -->
        <div class="row align-items-center mb-4 overflow-hidden">
            <div class="col-sm-3">
                <label class="fw-bold" style="font-size:larger;">Division</label>
                <select tabindex="-1" class="listDivision select2" multiple="multiple" id="listDivision" title="Select Division">
                </select>
            </div>
            <div class="col-sm-3">
                <label class="fw-bold" style="font-size:larger;">Plant</label>
                <select tabindex="-1" class="listPlant select2" multiple="multiple" id="listPlant" title="Select Plant">
                </select>
            </div>
            <div class="col-sm-2">
                <label class="fw-bold" style="font-size:larger;">From</label>
                <input id="FromDate" type="date" class="form-control">
            </div>
            <div class="col-sm-2">
                <label class="fw-bold" style="font-size:larger;">To</label>
                <input id="ToDate" type="date" class="form-control">
            </div>
            <div class="col-sm-2 mt-4">
                <button class="btn btn-outline-danger" onclick="exportToPDF()">
                    <i class="fa-solid fa-file-pdf me-2"></i>Export To PDF
                </button>
            </div>
        </div>

        <!-- Charts -->
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6 class="mb-2">CSO Logs Monthwise</h6>
                    <canvas id="monthwiseChart"></canvas>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6 class="mb-2">CSO Logs Phase Wise</h6>
                    <canvas id="phaseWiseAgingChart"></canvas>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6 class="mb-2">CSO by Plants</h6>
                    <canvas id="plantwiseChart"></canvas>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6 class="mb-2">Open vs Closed</h6>
                    <canvas id="openCloseChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <script asp-append-version="true">
        $(document).ready(function () {
            $('.select2').each(function () {
                var placeholderText = $(this).attr('title') || "";
                $(this).select2({
                    placeholder: placeholderText,
                    allowClear: true,
                    width: '100%'
                });
            });

            GetDivisionList();

            var fYear = $("#ddlFinancialYear").val();
            var fDate = "20" + fYear.slice(0, 2)  + "-04-01";
            var tDate = "20" + fYear.slice(-2) + "-03-31";
            $("#FromDate").val(fDate);
            $("#ToDate").val(tDate);

            setTimeout(() => {
                getDashboardData();
            }, 100);

            $("#listDivision").on('change', function () {
                Blockloadershow();
                var items = '';
                $('.listDivision option:selected').each(function (i) {
                    items += $(this).val() + ','
                });

                $.ajax({
                    url: '@Url.Action("GetPlantList", "DashBoard")',
                    type: "GET",
                    data: { divisionIds: items },
                    success: function (response) {
                        Blockloaderhide();
                        $('#listPlant').empty();
                        if (response.plantList.length > 0) {
                            response.plantList.forEach(function (item) {
                                var option = new Option(item.text, item.value, false, false);
                                if (item.disabled) option.disabled = true;
                                $('#listPlant').append(option);
                            });
                        }
                        getDashboardData();
                    },
                    error: function (xhr, status, error) {
                        Blockloaderhide();
                        showDangerAlert('Error retrieving data: ' + error);
                    }
                });
            });

            $("#listPlant").on('change', function () {
                var plantId = $('#listPlant').val();
                if (plantId) {
                    getDashboardData();
                }
            });

            $("#FromDate").on('change', function () {
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                if(fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
                    showDangerAlert("From Date cannot be greater than To Date.");
                    return false;
                }
                getDashboardData();
            });

            $("#ToDate").on('change', function () {
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                if(fromDate && toDate && new Date(fromDate) > new Date(toDate)) {
                    showDangerAlert("From Date cannot be greater than To Date.");
                    return false;
                }
                getDashboardData();
            });

            $('#btnOpenStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = $(this).data('status');
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });

            $('#btnRootCauseStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = $(this).data('status');
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });

            $('#btnMonitorStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = $(this).data('status');
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });

            $('#btnApproveStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = $(this).data('status');
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });

            $('#btnCloseStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = $(this).data('status');
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });

            $('#btnAllStatus').click(function (e) {
                e.preventDefault(); // Stop standard link behavior
                var status = '';
                var selectedDivisions = '';
                $('.listDivision option:selected').each(function (i) {
                    selectedDivisions += $(this).val() + ','
                });
                var selectedPlants = '';
                $('.listPlant option:selected').each(function (i) {
                    selectedPlants += $(this).val() + ','
                });
                var fromDate = $('#FromDate').val();
                var toDate = $('#ToDate').val();
                var baseUrl = '@Url.Action("Index", "CSOLogAnalysisSolution")';
                var finalUrl = baseUrl +
                               '?status=' + encodeURIComponent(status) +
                               '&divisionIds=' + encodeURIComponent(selectedDivisions) +
                               '&plantIds=' + encodeURIComponent(selectedPlants) +
                               '&fromDate=' + encodeURIComponent(fromDate) +
                               '&toDate=' + encodeURIComponent(toDate);
                window.location.href = finalUrl;
            });
        });

        let monthwiseChartInstance;
        let phaseWiseAgingChartInstance;
        let plantwiseChartInstance;
        let openCloseChartInstance;

        function GetDivisionList() {
            Blockloadershow();
            $.ajax({
                url: '@Url.Action("GetDivisionList", "DashBoard")',
                type: "GET",
                success: function (response) {
                    Blockloaderhide();
                    $('#listDivision').empty();
                    if (response.length > 0) {
                        response.forEach(function (item) {
                            var option = new Option(item.text, item.value, false, false);
                            if (item.disabled) option.disabled = true;
                            $('#listDivision').append(option);
                        });
                    }
                    getDashboardData();
                },
                error: function (xhr, status, error) {
                    Blockloaderhide();
                    showDangerAlert('Error retrieving data: ' + error);
                }
            });
        }

        function getDashboardData() {
            Blockloadershow();

            var divisions = '';
            $('.listDivision option:selected').each(function (i) {
                divisions += $(this).val() + ','
            });

            var plants = '';
            $('.listPlant option:selected').each(function (i) {
                plants += $(this).val() + ','
            });

            $.ajax({
                url: '@Url.Action("GetDashboardData", "DashBoard")',
                type: 'GET',
                data: { fYear: $("#ddlFinancialYear").val(), divisionIds: divisions, plantIds: plants, fromDate: $("#FromDate").val(), toDate: $("#ToDate").val() },
                success: function (response) {
                    Blockloaderhide();
                    if (response) {
                        $('#openCount').text(response.openCount);
                        $('#rootCausedCount').text(response.rootCausedCount);
                        $('#monitoredCount').text(response.monitoredCount);
                        $('#approvedCount').text(response.approvedCount);
                        $('#closedCount').text(response.closedCount);
                        $('#allCount').text(response.allCount);

                        // Destroy old chart if it exists
                        if (monthwiseChartInstance) {
                            monthwiseChartInstance.destroy();
                        }
                        if (phaseWiseAgingChartInstance) {
                            phaseWiseAgingChartInstance.destroy();
                        }
                        if (plantwiseChartInstance) {
                            plantwiseChartInstance.destroy();
                        }
                        if (openCloseChartInstance) {
                            openCloseChartInstance.destroy();
                        }

                        monthwiseChartInstance = new Chart("monthwiseChart", {
                          type: "bar",
                          data: {
                            labels: ["Apr", "May", "Jun", "Jul", "Aug", "Sept", "Oct", "Nov", "Dec", "Jan", "Feb", "Mar"],
                            datasets: [
                                { 
                                  label: "CSO Logs", 
                                  data: [
                                      response.april_AllCount,
                                      response.may_AllCount,
                                      response.june_AllCount,
                                      response.july_AllCount,
                                      response.august_AllCount,
                                      response.september_AllCount,
                                      response.october_AllCount,
                                      response.november_AllCount,
                                      response.december_AllCount,
                                      response.january_AllCount,
                                      response.february_AllCount,
                                      response.march_AllCount
                                  ], 
                                  backgroundColor: "#0d6efd" 
                                }
                            ]
                          },
                          options: { responsive: true, scales: { y: { beginAtZero: true, title: { display: true, text: 'Number of CSO Logs' } }, x: { title: { display: true, text: 'Month' } } } }
                        });

                        phaseWiseAgingChartInstance = new Chart("phaseWiseAgingChart", {
                          type: "bar",
                          data: {
                              labels: ["Root Cause", "Monitor", "Approve/Reject", "Close"],
                              datasets: [
                                  {
                                      label: "Root Cause > " + response.rootCauseThresholdDays,
                                      data: [response.rootCauseOverdueCount, 0, 0, 0],
                                      backgroundColor: "#dc3545" // Red for Root Cause
                                  },
                                  {
                                      label: "Monitor > " + response.monitorThresholdDays,
                                      data: [0, response.monitorOverdueCount, 0, 0],
                                      backgroundColor: "#ffc107" // Yellow for Monitor
                                  },
                                  {
                                      label: "Approve/Reject > " + response.approveThresholdDays,
                                      data: [0, 0, response.approveOverdueCount, 0],
                                      backgroundColor: "#007bff" // Blue for Approve
                                  },
                                  {
                                      label: "Close > " + response.closureThresholdDays,
                                      data: [0, 0, 0, response.closureOverdueCount],
                                      backgroundColor: "#28a745" // Green for Close
                                  }
                              ]
                          },
                          options: {
                              scales: {
                                  x: {
                                      stacked: true
                                  },
                                  y: {
                                      stacked: true
                                  }
                              }
                          }
                        });

                        // Extract plant names for labels and counts for data
                        const plantLabels = response.plantData.map(plant => plant.plantName);
                        const plantData = response.plantData.map(plant => plant.allCount);

                        // Dynamically generate colors for each plant
                        const dynamicColors = plantData.map(() => generateRandomColor());

                        plantwiseChartInstance = new Chart("plantwiseChart", {
                            type: "doughnut",
                            data: {
                                labels: plantLabels,
                                datasets: [{
                                    data: plantData,
                                    backgroundColor: dynamicColors
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: {
                                    legend: {
                                        position: 'top',
                                    }
                                }
                            }
                        });

                        openCloseChartInstance = new Chart("openCloseChart", {
                            type: "pie",
                            data: {
                              labels: ["Open", "Closed"],
                              datasets: [{ data: [response.overallOpenCount, response.overallClosedCount], backgroundColor: ["#0dcaf0", "#198754"] }]
                            }
                        });
                    }
                },
                error: function (xhr, status, error) {
                    showDangerAlert('Error retrieving data: ' + error);
                    Blockloaderhide();
                }
            });
        }

        // Function to generate a random, vibrant hex color
        function generateRandomColor() {
            const letters = '0123456789ABCDEF';
            let color = '#';
            for (let i = 0; i < 6; i++) {
                color += letters[Math.floor(Math.random() * 16)];
            }
            return color;
        }

        function exportToPDF() {
            try {
                // Initialize jsPDF (from the UMD library you included)
                const { jsPDF } = window.jspdf;
                // Create a new PDF in Portrait, using millimeters, on A4 paper
                const doc = new jsPDF('p', 'mm', 'a4');

                // --- PDF Layout Constants ---
                const margin = 15; // Page margin
                const chartGap = 20; // Gap between charts
                const pageWidth = doc.internal.pageSize.getWidth();
                const contentWidth = pageWidth - (margin * 2);

                // --- Page 1: Bar Charts ---

                // Chart 1: Monthwise (Bar Chart)
                const imgMonthwise = monthwiseChartInstance.toBase64Image();
                let chartHeight = (contentWidth / 16) * 9; // 16:9 aspect ratio
                let yPos = 25; // Start position (with space for title)

                doc.setFontSize(16);
                doc.text("CSO Logs Monthwise", margin, yPos - 8);
                doc.addImage(imgMonthwise, 'PNG', margin, yPos, contentWidth, chartHeight);
                yPos += chartHeight + chartGap; // Update Y position

                // Chart 2: Phase Wise (Bar Chart)
                const imgPhaseWise = phaseWiseAgingChartInstance.toBase64Image();
                chartHeight = (contentWidth / 16) * 9; // 16:9 aspect ratio

                doc.setFontSize(16);
                doc.text("CSO Logs Phase Wise", margin, yPos - 8);
                doc.addImage(imgPhaseWise, 'PNG', margin, yPos, contentWidth, chartHeight);


                // --- Page 2: Pie/Doughnut Charts ---
                doc.addPage();
                yPos = 25; // Reset Y position for new page

                // Chart 3: CSO by Plants (Doughnut)
                // --- THIS IS THE CORRECTED LINE ---
                const imgPlantwise = plantwiseChartInstance.toBase64Image();

                // Pie/Doughnut charts look better as squares (1:1 aspect ratio)
                let squareSize = contentWidth * 0.7; // Use 70% of width
                let xPos = (pageWidth - squareSize) / 2; // Center the chart

                doc.setFontSize(16);
                doc.text("CSO by Plants", margin, yPos - 8);
                doc.addImage(imgPlantwise, 'PNG', xPos, yPos, squareSize, squareSize);
                yPos += squareSize + chartGap;

                // Chart 4: Open vs Closed (Pie)
                const imgOpenClose = openCloseChartInstance.toBase64Image();
                squareSize = contentWidth * 0.7; // 1:1
                xPos = (pageWidth - squareSize) / 2; // Center

                doc.setFontSize(16);
                doc.text("Open vs Closed", margin, yPos - 8);
                doc.addImage(imgOpenClose, 'PNG', xPos, yPos, squareSize, squareSize);

                // 4. Save the PDF
                doc.save('CSO_Dashboard_Charts.pdf');

            } catch (error) {
                console.error("Error exporting to PDF:", error);
                showDangerAlert('An error occurred while exporting the PDF.');
            }
        }
    </script>
</body>
</html>
